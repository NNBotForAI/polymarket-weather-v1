# App
APP_NAME=polymarket-weather-v1
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/polymarket_weather

# Polymarket API
POLYMARKET_API_BASE=https://gamma-api.polymarket.com

# Weather API (OpenWeatherMap or similar)
WEATHER_API_KEY=your-api-key-here
